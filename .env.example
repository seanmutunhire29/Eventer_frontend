# Backend API base URL
# Use your LAN IP when testing on a physical device (not localhost)
# Android emulator: auto-rewrites localhost → 10.0.2.2 in src/api/client.ts
# iOS simulator: http://localhost:8000
# Physical device: leave as localhost — the app auto-uses Metro's LAN IP
EXPO_PUBLIC_API_URL=http://localhost:8000

# Stadia Maps API key (used for the "Alidade Smooth" map tiles)
# Create a free key at https://client.stadiamaps.com/dashboard/
# NOTE: EXPO_PUBLIC_* values are embedded in the app bundle at build time.
EXPO_PUBLIC_STADIA_API_KEY=
